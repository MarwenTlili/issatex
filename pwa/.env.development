# use "openssl rand -base64 32" to generate SECRET

# --- RUNTIME CONFIG ---
# options: development, test, production
NODE_ENV=development

# --- TLS BEHAVIOR ---
NODE_TLS_REJECT_UNAUTHORIZED=0

# --- NEXTAUTH CONFIG ---
NEXTAUTH_DEBUG=true
NEXTAUTH_URL=https://localhost
NEXTAUTH_SECRET=

# --- API & MERCURE ROUTING ---
NEXT_PUBLIC_ENTRYPOINT=https://localhost
NEXT_PUBLIC_MERCURE_PUBLIC_URL=https://localhost/.well-known/mercure
