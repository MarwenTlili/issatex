# --- RUNTIME CONFIG ---
NODE_ENV=development

# --- TLS BEHAVIOR ---
NODE_TLS_REJECT_UNAUTHORIZED=0

# --- NEXTAUTH CONFIG ---
NEXTAUTH_DEBUG=true
NEXTAUTH_URL=https://localhost
NEXTAUTH_SECRET="!ChangeThisNextAuthSecret!"

# --- API & MERCURE ROUTING ---
NEXT_PUBLIC_ENTRYPOINT=http://php
NEXT_PUBLIC_MERCURE_PUBLIC_URL=https://localhost/.well-known/mercure
NEXT_PUBLIC_API_URL=https://localhost
