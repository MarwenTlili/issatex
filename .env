# use "$openssl rand -base64 32" to generate SECRET

# --- Infrastructure level environment ---
PWA_UPSTREAM="pwa:3000"

# --- IMAGES ---
IMAGES_PREFIX=issatex

# --- SERVER ---
SERVER_NAME=localhost

# --- MERCURE ---
CADDY_MERCURE_URL=http://php/.well-known/mercure
CADDY_MERCURE_PUBLIC_URL="https://${SERVER_NAME}/.well-known/mercure"
CADDY_MERCURE_JWT_SECRET=

# --- DATABASE ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_VERSION=16
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}?serverVersion=${POSTGRES_VERSION}"

# --- NETWORK ---
HTTP_PORT=80
HTTPS_PORT=443
HTTP3_PORT=443
